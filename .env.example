# Copy to .env and fill credentials. Keep this file compatible with Bash source.
# .env is private; exported values with the same name are replaced when scripts load it.
JAVA_OPTS='-Xms192m -Xmx192m -Djava.security.egd=file:/dev/./urandom -Duser.timezone=Asia/Shanghai'

# Compose database service and host port. The database is initialized with root.
MYSQL_HOST=mysql
MYSQL_PORT=13306
MYSQL_DATABASE=miaosha
MYSQL_USERNAME=root
MYSQL_PASSWORD=''

# Local Maven connection. Container scripts explicitly use their Docker network address.
SPRING_DATASOURCE_URL='jdbc:mysql://127.0.0.1:13306/miaosha?useUnicode=true&characterEncoding=UTF-8&useSSL=false'

# Local Maven defaults. For Compose, use addresses reachable from the App container
# (for example host.docker.internal on Docker Desktop), not its own loopback address.
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=''
MQ_NAMESERVER_ADDR=127.0.0.1:19876
MQ_TOPICNAME=stock_topic

# Optional manual MyBatis Generator connection; never run it against a production database.
GENERATOR_JDBC_URL='jdbc:mysql://127.0.0.1:13306/miaosha?useUnicode=true&characterEncoding=UTF-8&useSSL=false'
GENERATOR_JDBC_USERNAME=root
GENERATOR_JDBC_PASSWORD=''
